# CosmicSeeker backend — production .env template.
#
# Copy to `.env` on the server (next to docker-compose.production.yml) and
# fill in the marked values. NEVER commit the real .env to git.

NODE_ENV=production
PORT=8787
DB_PATH=/data/cosmic-seeker.db

# ─── Solana RPC ──────────────────────────────────────────────────────────
# Devnet for the test APK; flip to mainnet-beta when shipping to real users.
SOL_RPC_URL=https://api.devnet.solana.com

# ─── ed25519 signer (REQUIRED) ───────────────────────────────────────────
# Freshly minted keypair — its matching pubkey will be the claim authority
# registered in the Anchor program:
#
#   pubkey: <redacted-leaked-pubkey>
#
# To rotate: re-run the keygen one-liner in docs/DEPLOY-COSMIC-SOULVIEW.md
# and update the pubkey in the on-chain program.
SIGNER_KEYPAIR_BASE58=<redacted-leaked-keypair-do-not-use>

# ─── CORS (REQUIRED in production) ───────────────────────────────────────
# Comma-separated list of origins permitted to call the API. The APK loads
# the bundled web app under `https://localhost` on Android (Capacitor) and
# under the `xyz.cosmicseeker.app://` custom scheme — `capacitor://localhost`
# is the correct allowlist entry. Also list any web hosts you serve the same
# frontend from.
CORS_ALLOWLIST=https://localhost,capacitor://localhost,https://cosmic.soulview.org

RATE_LIMIT_RPS=30

# ─── Public URLs (used in Stripe redirect + OAuth callbacks) ─────────────
PUBLIC_BACKEND_URL=https://cosmic.soulview.org
PUBLIC_APP_URL=https://cosmic.soulview.org

# ─── Optional integrations ───────────────────────────────────────────────
# Stripe checkout completions are queued in `pending_mints` until the
# Anchor `buy_item` worker drains them onto Solana.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

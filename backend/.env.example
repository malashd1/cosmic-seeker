# ─── Required for production (NODE_ENV=production) ──────────────────
# Backend refuses to boot if any of these are missing or use dev defaults.

NODE_ENV=development
PORT=8787

# Solana RPC. Defaults to devnet in dev, mainnet-beta in prod when unset.
# `RPC_URL` is honoured as a fallback alias for compatibility with old
# .env files from the EVM era.
SOL_RPC_URL=https://api.devnet.solana.com

# Ed25519 signer keypair for the Solana claim path. Base58-encoded 64-byte
# secret key — same format as `Keypair.secretKey` from @solana/web3.js.
# Mint one in node:
#   node --input-type=module -e 'import nacl from "tweetnacl"; import bs58 from "bs58"; \
#     const kp = nacl.sign.keyPair(); \
#     console.log("SIGNER_KEYPAIR_BASE58=" + bs58.encode(kp.secretKey)); \
#     console.log("# pubkey: " + bs58.encode(kp.publicKey));'
# In production: store the value in a secret manager (AWS KMS / GCP Secret
# Manager / HashiCorp Vault); the matching pubkey must be registered as the
# claim authority in the Anchor program.
# If unset in dev mode, a deterministic well-known dev keypair is used; prod
# refuses to boot with that value.
SIGNER_KEYPAIR_BASE58=

# Comma-separated allowlist of origins permitted to call the API.
# Leave empty in development to reflect any origin. REQUIRED in production.
# Example: https://cosmic.soulview.org,capacitor://localhost,https://localhost
CORS_ALLOWLIST=

# Requests per IP per minute. Default 30.
RATE_LIMIT_RPS=30

# SQLite database path. Use an absolute path on a persistent volume in production.
DB_PATH=cosmic-seeker.db


# ─── Optional integrations ───────────────────────────────────────────

# Stripe fiat onramp. Leave blank to disable the /api/stripe/* endpoints.
# Completed checkouts are queued in the `pending_mints` SQLite table; the
# Anchor `buy_item` worker (TBD) drains the queue.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Social linking (Discord + X/Twitter OAuth2). Leave blank to disable.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Public URLs used in OAuth redirects + Stripe checkout success/cancel.
# Must be reachable from the user's browser.
PUBLIC_BACKEND_URL=http://localhost:8787
PUBLIC_APP_URL=http://localhost:5173

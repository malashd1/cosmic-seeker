# Cosmic Seeker — frontend env vars (Vite reads VITE_* at build time).
#
# Two networks are recognised: `devnet` (default during development; backend
# may also live on a LAN IP for phone testing) and `mainnet`. Pick via
# `VITE_DEFAULT_NETWORK`.

VITE_DEFAULT_NETWORK=devnet

# ─── devnet ──────────────────────────────────────────────────────────────
# Backend URL — leave blank to default to `<page-host>:8787`.
VITE_BACKEND_URL_TEST=
# Solana JSON-RPC.
VITE_SOL_RPC_TEST=https://api.devnet.solana.com
# SKR SPL mint address. Empty → shop falls back to off-chain credit only.
VITE_SKR_MINT_TEST=
# Treasury wallet (or PDA) that receives shop-purchase SKR. Same fallback.
VITE_TREASURY_TEST=
# CosmicSeeker Anchor program id (set after `anchor deploy`).
VITE_COSMIC_PROGRAM_ID_TEST=
# Decimals of the SKR mint. Default 6 matches spl-token Anchor tests.
VITE_SKR_DECIMALS_TEST=6

# ─── mainnet ─────────────────────────────────────────────────────────────
VITE_BACKEND_URL=https://api.cosmicseeker.xyz
VITE_SOL_RPC=https://api.mainnet-beta.solana.com
VITE_SKR_MINT=
VITE_TREASURY=
VITE_COSMIC_PROGRAM_ID=
VITE_SKR_DECIMALS=6

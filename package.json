{
  "name": "cosmic-seeker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Galaxian-inspired arcade shooter PWA. Pays for upgrades in $SKR on Solana via Mobile Wallet Adapter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:levels": "tsx scripts/generate-levels.ts",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:twa-icons": "node scripts/generate-twa-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs || echo 'icons skipped (sharp not installed)'",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.1.4",
    "@solana-mobile/wallet-standard-mobile": "^0.4.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-standard-features": "^1.3.0",
    "@solana/web3.js": "^1.95.3",
    "@wallet-standard/app": "^1.1.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
